# AMC seat bot — copy to `.env` and fill in what you need. `.env` is gitignored.

# --- What to watch ------------------------------------------------------------
# The number in amctheatres.com/showtimes/<ID>/seats
AMC_SHOWTIME_ID=

# --- Data source --------------------------------------------------------------
# amc-api (recommended) | amc-web | mock
AMC_PROVIDER=amc-api
# Free vendor key for catalog/seating access: https://developers.amctheatres.com/
AMC_VENDOR_KEY=
# Optional: exact seating-layout URL override (from browser DevTools) if the
# bot can't auto-discover it.
# AMC_SEATING_LAYOUT_URL=
# Optional: AMC Stubs account to reveal premiere/reserved-tier availability.
# AMC_ACCOUNT_ID=
# AMC_LOYALTY_CARD=

# --- Polling ------------------------------------------------------------------
AMC_INTERVAL_SECONDS=60
AMC_JITTER_SECONDS=10

# --- Notifications (enable any subset; console is always on) -------------------
# Telegram (easiest phone push): make a bot via @BotFather, DM it once, then read
# your chat id at https://api.telegram.org/bot<token>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord: Channel settings -> Integrations -> Webhooks -> New Webhook -> copy URL
# DISCORD_WEBHOOK_URL=

# Slack incoming webhook
# SLACK_WEBHOOK_URL=

# Generic webhook — receives the full JSON payload (wire to Zapier/IFTTT/email/SMS)
# WEBHOOK_URL=

# Desktop notification (osascript / notify-send / BurntToast). 1 to enable.
# NOTIFY_DESKTOP=1
